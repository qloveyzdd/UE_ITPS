{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ue-itps:edittools:ue_editor_find_blueprint_references",
  "oneOf": [
    {"$ref": "#/$defs/success"},
    {"allOf": [{"$ref": "urn:ue-itps:edittools:common#/$defs/errorDocument"}, {"properties": {"schema_version": {"const": "ue_editor_find_blueprint_references"}}}]}
  ],
  "$defs": {
    "success": {
      "type": "object",
      "required": ["schema_version", "editor", "editor_state", "roots", "targets", "scanned_asset_count", "match_count", "matches", "validation", "limits"],
      "properties": {
        "schema_version": {"const": "ue_editor_find_blueprint_references"},
        "editor": {"$ref": "urn:ue-itps:edittools:common#/$defs/editor"},
        "editor_state": {"type": "object"},
        "roots": {"type": "array", "items": {"type": "string"}},
        "targets": {"type": "array", "items": {"type": "string"}},
        "scanned_asset_count": {"type": "integer", "minimum": 0},
        "match_count": {"type": "integer", "minimum": 0},
        "matches": {"type": "array", "items": {"type": "object"}},
        "validation": {"$ref": "urn:ue-itps:edittools:common#/$defs/validation"},
        "limits": {"$ref": "urn:ue-itps:edittools:common#/$defs/limits"}
      },
      "additionalProperties": false
    }
  }
}
