{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ue-itps:edittools:ue_editor_list_sessions",
  "oneOf": [
    {"$ref": "#/$defs/success"},
    {"allOf": [{"$ref": "urn:ue-itps:edittools:common#/$defs/errorDocument"}, {"properties": {"schema_version": {"const": "ue_editor_list_sessions"}}}]}
  ],
  "$defs": {
    "success": {
      "type": "object",
      "required": ["schema_version", "engine_root", "engine_version", "sessions", "validation", "limits"],
      "properties": {
        "schema_version": {"const": "ue_editor_list_sessions"},
        "engine_root": {"type": "string"},
        "engine_version": {"type": "string"},
        "sessions": {"type": "array", "items": {"type": "object"}},
        "validation": {"$ref": "urn:ue-itps:edittools:common#/$defs/validation"},
        "limits": {"$ref": "urn:ue-itps:edittools:common#/$defs/limits"}
      },
      "additionalProperties": false
    }
  }
}
