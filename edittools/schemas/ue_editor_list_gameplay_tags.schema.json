      "type": "object",
      "required": ["schema_version", "editor", "parent_tag", "tags", "tag_infos", "validation", "limits"],
      "properties": {
        "schema_version": {"const": "ue_editor_list_gameplay_tags"},
        "editor": {"$ref": "urn:ue-itps:edittools:common#/$defs/editor"},
        "parent_tag": {"type": "string"},
        "tags": {"type": "array", "items": {"type": "string"}},
        "tag_infos": {"type": "array", "items": {"type": "object"}},
        "validation": {"$ref": "urn:ue-itps:edittools:common#/$defs/validation"},
        "limits": {"$ref": "urn:ue-itps:edittools:common#/$defs/limits"}
      },
      "additionalProperties": false
    }
  }
}
