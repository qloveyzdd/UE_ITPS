{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ue-itps:schema:ue_inspect_module_entry",
  "title": "ue_inspect_module_entry.py result",
  "oneOf": [
    {
      "$ref": "#/$defs/success"
    },
    {
      "allOf": [
        {
          "$ref": "urn:ue-itps:schema:common#/$defs/errorDocument"
        },
        {
          "properties": {
            "schema_version": {
              "const": "ue_inspect_module_entry"
            }
          }
        }
      ]
    }
  ],
  "$defs": {
    "success": {
      "type": "object",
      "required": [
        "schema_version",
        "entrypoints",
        "validation",
        "limits"
      ],
      "properties": {
        "schema_version": {
          "const": "ue_inspect_module_entry"
        },
        "entrypoints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["header", "source", "registration"],
            "properties": {
              "header": {"type": ["string", "null"]},
              "source": {"type": "string", "minLength": 1},
              "registration": {
                "type": "object",
                "required": [
                  "macro",
                  "module_class",
                  "module_name",
                  "source_line"
                ],
                "properties": {
                  "macro": {
                    "enum": [
                      "IMPLEMENT_PRIMARY_GAME_MODULE",
                      "IMPLEMENT_MODULE"
                    ]
                  },
                  "module_class": {"type": ["string", "null"]},
                  "module_name": {"type": "string", "minLength": 1},
                  "source_line": {"type": "integer", "minimum": 1}
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "validation": {
          "$ref": "urn:ue-itps:schema:common#/$defs/validation"
        },
        "limits": {
          "$ref": "urn:ue-itps:schema:common#/$defs/limits"
        }
      },
      "additionalProperties": false
    }
  }
}
