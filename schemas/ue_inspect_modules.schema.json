{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ue-itps:schema:project-modules:v1",
  "title": "ue_inspect_modules.py result",
  "oneOf": [
    {
      "$ref": "#/$defs/success"
    },
    {
      "allOf": [
        {
          "$ref": "urn:ue-itps:schema:common:v1#/$defs/errorDocument"
        },
        {
          "properties": {
            "schema_version": {
              "const": "ue-itps.project-modules.v1"
            }
          }
        }
      ]
    }
  ],
  "$defs": {
    "success": {
      "type": "object",
      "required": [
        "schema_version",
        "reconciled_module_count",
        "items",
        "validation",
        "limits"
      ],
      "properties": {
        "schema_version": {
          "const": "ue-itps.project-modules.v1"
        },
        "reconciled_module_count": {
          "type": "integer",
          "minimum": 0
        },
        "items": {
          "type": "array"
        },
        "validation": {
          "$ref": "urn:ue-itps:schema:common:v1#/$defs/validation"
        },
        "limits": {
          "$ref": "urn:ue-itps:schema:common:v1#/$defs/limits"
        }
      },
      "additionalProperties": false
    }
  }
}
