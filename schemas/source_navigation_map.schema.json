{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ue-itps:schema:source_navigation_map",
  "title": "Reusable source navigation map (pilot)",
  "oneOf": [
    {"$ref": "#/$defs/success"},
    {"allOf": [
      {"$ref": "urn:ue-itps:schema:common#/$defs/errorDocument"},
      {"properties": {"schema_version": {"const": "source_navigation_map"}}}
    ]}
  ],
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "count": {"type": "integer", "minimum": 0},
    "definitionCount": {"type": "integer", "minimum": 1},
    "location": {
      "type": "object", "required": ["path", "line"],
      "properties": {"path": {"$ref": "#/$defs/text"}, "line": {"type": "integer", "minimum": 1},
        "column": {"type": "integer", "minimum": 1}, "end_line": {"type": "integer", "minimum": 1},
        "byte_offset": {"type": "integer", "minimum": 0}}, "additionalProperties": false
    },
    "check": {
      "type": "object", "required": ["kind", "name"],
      "properties": {"kind": {"enum": ["call", "member", "statement"]}, "name": {"$ref": "#/$defs/text"}},
      "additionalProperties": false
    },
    "observedCheck": {
      "type": "object", "required": ["kind", "name", "matches"],
      "properties": {"kind": {"enum": ["call", "member", "statement"]}, "name": {"$ref": "#/$defs/text"},
        "matches": {"type": "array", "items": {
          "type": "object", "required": ["expression", "evidence"],
          "properties": {"expression": {"$ref": "#/$defs/text"}, "evidence": {"$ref": "#/$defs/location"},
            "target": {"type": "string"}, "value": {"type": "string"},
            "arguments": {"type": "array", "items": {"type": "string"}},
            "execution_scope": {"type": "object", "required": ["kind"],
              "properties": {"kind": {"enum": ["function", "lambda"]}, "line": {"type": "integer", "minimum": 1},
                "column": {"type": "integer", "minimum": 1}}, "additionalProperties": false}},
          "additionalProperties": false}}}, "additionalProperties": false
    },
    "navigation": {
      "type": "object",
      "required": ["id", "intent", "purpose", "kind", "target", "role", "reason", "checks", "status", "evidence_status", "definitions"],
      "properties": {
        "id": {"$ref": "#/$defs/text"}, "intent": {"$ref": "#/$defs/text"},
        "purpose": {"enum": ["behavior", "structure"]}, "kind": {"enum": ["function", "type"]},
        "target": {"$ref": "#/$defs/text"}, "role": {"enum": ["system_entry", "internal_function", "type_structure"]},
        "reason": {"$ref": "#/$defs/text"},
        "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
        "status": {"enum": ["reviewed", "candidate", "unresolved"]},
        "evidence_status": {"enum": ["matched", "partial", "missing"]},
        "definitions": {"type": "array", "items": {"type": "object", "required": ["evidence", "checks"],
          "properties": {"evidence": {"$ref": "#/$defs/location"},
            "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/observedCheck"}}}, "additionalProperties": false}},
        "query": {"type": "object", "required": ["tool", "selector"],
          "properties": {"tool": {"enum": ["ue_inspect_cxx_type", "ue_inspect_cxx_function"]},
            "selector": {"$ref": "#/$defs/text"}, "view": {"enum": ["behavior", "structure"]},
            "include_syntax_flow": {"const": true},
            "focus": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}}, "additionalProperties": false}
      }, "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"status": {"const": "unresolved"}}},
         "then": {"not": {"required": ["query"]}}, "else": {"required": ["query"]}},
        {"if": {"properties": {"status": {"const": "reviewed"}}},
         "then": {"properties": {"evidence_status": {"const": "matched"}, "definitions": {"minItems": 1, "maxItems": 1}}}}
      ]
    },
    "type": {
      "type": "object", "required": ["name", "kind", "roles", "definition_count"],
      "properties": {
        "name": {"$ref": "#/$defs/text"},
        "kind": {"enum": ["class", "struct", "union", "enum"]},
        "roles": {"type": "array", "items": {"$ref": "#/$defs/text"}},
        "definition_count": {"$ref": "#/$defs/definitionCount"}
      }, "additionalProperties": false
    },
    "entry": {
      "type": "object", "required": ["name", "definition_count"],
      "properties": {"name": {"$ref": "#/$defs/text"}, "definition_count": {"$ref": "#/$defs/definitionCount"}},
      "additionalProperties": false
    },
    "unit": {
      "type": "object", "required": ["id", "sources", "types", "entry_points", "function_definition_count"],
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "sources": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "types": {"type": "array", "items": {"$ref": "#/$defs/type"}},
        "entry_points": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
        "function_definition_count": {"$ref": "#/$defs/count"},
        "source_hashes": {"type": "object", "minProperties": 1, "maxProperties": 2,
          "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
        "review_status": {"enum": ["unreviewed", "current", "stale"]},
        "navigation": {"type": "array", "items": {"$ref": "#/$defs/navigation"}}
      }, "additionalProperties": false
    },
    "success": {
      "type": "object",
      "required": ["schema_version", "project", "snapshot", "scope", "classification_source", "units", "summary", "validation", "limits"],
      "properties": {
        "schema_version": {"const": "source_navigation_map"},
        "project": {"$ref": "#/$defs/text"},
        "snapshot": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
        "scope": {
          "type": "object", "required": ["id", "name", "description"],
          "properties": {"id": {"$ref": "#/$defs/text"}, "name": {"$ref": "#/$defs/text"}, "description": {"$ref": "#/$defs/text"}},
          "additionalProperties": false
        },
        "classification_source": {"const": "profile"},
        "units": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/unit"}},
        "summary": {
          "type": "object", "required": ["units", "files", "types", "functions"],
          "properties": {"units": {"$ref": "#/$defs/count"}, "files": {"$ref": "#/$defs/count"}, "types": {"$ref": "#/$defs/count"}, "functions": {"$ref": "#/$defs/count"}},
          "additionalProperties": false
        },
        "validation": {"$ref": "urn:ue-itps:schema:common#/$defs/validation"},
        "limits": {"$ref": "urn:ue-itps:schema:common#/$defs/limits"}
      }, "additionalProperties": false
    }
  }
}
