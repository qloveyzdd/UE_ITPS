{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ue-itps:schema:ue_inspect_module_rules",
  "title": "ue_inspect_module_rules.py result",
  "oneOf": [
    {
      "$ref": "#/$defs/success"
    },
    {
      "allOf": [
        {
          "$ref": "urn:ue-itps:schema:common#/$defs/errorDocument"
        },
        {
          "properties": {
            "schema_version": {
              "const": "ue_inspect_module_rules"
            }
          }
        }
      ]
    }
  ],
  "$defs": {
    "success": {
      "type": "object",
      "required": [
        "schema_version",
        "rules_classes",
        "validation",
        "limits"
      ],
      "properties": {
        "schema_version": {
          "const": "ue_inspect_module_rules"
        },
        "rules_classes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rulesClass"
          }
        },
        "validation": {
          "$ref": "urn:ue-itps:schema:common#/$defs/validation"
        },
        "limits": {
          "$ref": "urn:ue-itps:schema:common#/$defs/limits"
        }
      },
      "additionalProperties": false
    },
    "rulesClass": {
      "type": "object",
      "required": [
        "name",
        "dependencies"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "dependencies": {
          "$ref": "#/$defs/dependencies"
        }
      },
      "additionalProperties": false
    },
    "dependencies": {
      "type": "object",
      "required": [
        "public",
        "private",
        "dynamic"
      ],
      "properties": {
        "public": {
          "$ref": "#/$defs/moduleNames"
        },
        "private": {
          "$ref": "#/$defs/moduleNames"
        },
        "dynamic": {
          "$ref": "#/$defs/moduleNames"
        }
      },
      "additionalProperties": false
    },
    "moduleNames": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    }
  }
}
