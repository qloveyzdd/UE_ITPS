{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ue-itps:schema:ue_find_projects",
  "title": "ue_find_projects.py result",
  "oneOf": [
    {
      "$ref": "#/$defs/success"
    },
    {
      "allOf": [
        {
          "$ref": "urn:ue-itps:schema:common#/$defs/errorDocument"
        },
        {
          "properties": {
            "schema_version": {
              "const": "ue_find_projects"
            }
          }
        }
      ]
    }
  ],
  "$defs": {
    "success": {
      "type": "object",
      "required": [
        "schema_version",
        "search_root",
        "status",
        "candidate_count",
        "candidates",
        "validation",
        "limits"
      ],
      "properties": {
        "schema_version": {
          "const": "ue_find_projects"
        },
        "search_root": {
          "type": "string"
        },
        "status": {
          "enum": ["not-found", "selected", "ambiguous"]
        },
        "candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "validation": {
          "$ref": "urn:ue-itps:schema:common#/$defs/validation"
        },
        "limits": {
          "$ref": "urn:ue-itps:schema:common#/$defs/limits"
        }
      },
      "additionalProperties": false
    }
  }
}
