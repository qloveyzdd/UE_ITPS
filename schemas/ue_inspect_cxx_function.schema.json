{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ue-itps:schema:cxx-function:v1",
  "title": "ue_inspect_cxx_function.py result",
  "oneOf": [
    {
      "$ref": "#/$defs/success"
    },
    {
      "allOf": [
        {
          "$ref": "urn:ue-itps:schema:common:v1#/$defs/errorDocument"
        },
        {
          "properties": {
            "schema_version": {
              "const": "ue-itps.cxx-function.v1"
            }
          }
        }
      ]
    }
  ],
  "$defs": {
    "success": {
      "type": "object",
      "required": [
        "schema_version",
        "path_roots",
        "context",
        "source_unit",
        "selection",
        "match_count",
        "matches",
        "validation",
        "limits"
      ],
      "properties": {
        "schema_version": {
          "const": "ue-itps.cxx-function.v1"
        },
        "path_roots": {
          "type": "object"
        },
        "context": {
          "type": "object"
        },
        "source_unit": {
          "type": "object"
        },
        "selection": {
          "type": "object",
          "required": ["name"]
        },
        "match_count": {
          "type": "integer",
          "minimum": 0
        },
        "matches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/match"
          }
        },
        "validation": {
          "$ref": "urn:ue-itps:schema:common:v1#/$defs/validation"
        },
        "limits": {
          "$ref": "urn:ue-itps:schema:common:v1#/$defs/limits"
        }
      },
      "additionalProperties": false
    },
    "match": {
      "type": "object",
      "required": [
        "function_id",
        "function",
        "relation",
        "external_symbols"
      ],
      "properties": {
        "function_id": {
          "type": "string",
          "minLength": 1
        },
        "function": {
          "$ref": "#/$defs/function"
        },
        "relation": {
          "type": "object"
        },
        "external_symbols": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/externalSymbol"
          }
        }
      },
      "additionalProperties": false
    },
    "function": {
      "type": "object",
      "required": [
        "kind",
        "namespace",
        "qualified_name",
        "owner",
        "name",
        "parameters",
        "signature",
        "qualifiers",
        "role"
      ],
      "properties": {
        "kind": {
          "enum": ["method", "free_function"]
        },
        "namespace": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "qualified_name": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": ["string", "null"]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "string"
        },
        "signature": {
          "type": "string",
          "minLength": 1
        },
        "qualifiers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "role": {
          "enum": ["declaration", "definition"]
        }
      },
      "additionalProperties": false
    },
    "externalSymbol": {
      "type": "object",
      "required": [
        "kind",
        "spelling",
        "evidence"
      ],
      "properties": {
        "kind": {
          "enum": [
            "type",
            "global_variable",
            "free_function",
            "member_call",
            "function_address",
            "callback_target",
            "unknown"
          ]
        },
        "spelling": {
          "type": "string",
          "minLength": 1
        },
        "owner_type": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/sourceEvidence"
        }
      },
      "additionalProperties": false
    },
    "sourceEvidence": {
      "type": "object",
      "required": [
        "unit",
        "line"
      ],
      "properties": {
        "unit": {
          "enum": [
            "cpp",
            "header"
          ]
        },
        "line": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  }
}
