{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ue-itps:schema:ue_inspect_cxx_function",
  "title": "ue_inspect_cxx_function.py result",
  "oneOf": [
    {
      "$ref": "#/$defs/success"
    },
    {
      "allOf": [
        {
          "$ref": "urn:ue-itps:schema:common#/$defs/errorDocument"
        },
        {
          "properties": {
            "schema_version": {
              "const": "ue_inspect_cxx_function"
            }
          }
        }
      ]
    }
  ],
  "$defs": {
    "success": {
      "type": "object",
      "required": [
        "schema_version",
        "delegate_contract_revision",
        "match_count",
        "matches",
        "validation",
        "limits"
      ],
      "properties": {
        "schema_version": {
          "const": "ue_inspect_cxx_function"
        },
        "match_count": {
          "type": "integer",
          "minimum": 0
        },
        "matches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/match"
          }
        },
        "validation": {
          "$ref": "urn:ue-itps:schema:common#/$defs/validation"
        },
        "limits": {
          "$ref": "urn:ue-itps:schema:common#/$defs/limits"
        },
        "delegate_contract_revision": {
          "const": 2
        }
      },
      "additionalProperties": false
    },
    "match": {
      "type": "object",
      "required": [
        "function_id",
        "external_symbols",
        "delegate_operations"
      ],
      "properties": {
        "function_id": {
          "type": "string",
          "minLength": 1
        },
        "external_symbols": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/externalSymbol"
          }
        },
        "delegate_operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/delegateOperation"
          }
        },
        "syntax_flow": {
          "type": "object",
          "description": "Present only when --include-syntax-flow is requested"
        }
      },
      "additionalProperties": false
    },
    "externalSymbol": {
      "type": "object",
      "required": [
        "kind",
        "spelling",
        "evidence"
      ],
      "properties": {
        "kind": {
          "enum": [
            "type",
            "global_variable",
            "free_function",
            "macro",
            "member_call",
            "function_address",
            "callback_target",
            "unknown"
          ]
        },
        "spelling": {
          "type": "string",
          "minLength": 1
        },
        "owner_type": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/sourceEvidence"
        }
      },
      "additionalProperties": false
    },
    "delegateOperation": {
      "type": "object",
      "required": [
        "operation_id",
        "operation",
        "api",
        "subject",
        "delegate_type",
        "callback",
        "binding",
        "arguments",
        "result",
        "resolution",
        "execution_scope",
        "evidence"
      ],
      "properties": {
        "operation_id": {
          "type": "string"
        },
        "operation": {
          "enum": [
            "create",
            "bind",
            "add",
            "unbind",
            "remove",
            "clear",
            "execute",
            "broadcast",
            "query"
          ]
        },
        "api": {
          "type": "string"
        },
        "subject": {
          "$ref": "#/$defs/delegateSubject"
        },
        "delegate_type": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/delegateType"
            }
          ]
        },
        "callback": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/delegateCallback"
            }
          ]
        },
        "binding": {
          "enum": [
            null,
            "static",
            "raw",
            "shared_weak",
            "uobject_weak",
            "lambda"
          ]
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "role",
              "expression"
            ],
            "properties": {
              "role": {
                "enum": [
                  "callback",
                  "delegate",
                  "function_name",
                  "object",
                  "payload",
                  "handle",
                  "invocation",
                  "unknown"
                ]
              },
              "expression": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "result": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "expression",
                "kind"
              ],
              "properties": {
                "expression": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "delegate",
                    "handle",
                    "value"
                  ]
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "resolution": {
          "type": "object",
          "required": [
            "status",
            "reasons"
          ],
          "properties": {
            "status": {
              "enum": [
                "identified",
                "candidate"
              ]
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "execution_scope": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "function"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "kind",
                "line",
                "column"
              ],
              "properties": {
                "kind": {
                  "const": "lambda"
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "column": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "evidence": {
          "$ref": "#/$defs/delegateEvidence"
        }
      },
      "additionalProperties": false
    },
    "sourceEvidence": {
      "type": "object",
      "required": [
        "unit",
        "line"
      ],
      "properties": {
        "unit": {
          "enum": [
            "cpp",
            "header"
          ]
        },
        "line": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "delegateEvidence": {
      "type": "object",
      "required": [
        "unit",
        "line",
        "column"
      ],
      "properties": {
        "unit": {
          "enum": [
            "cpp",
            "header"
          ]
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "delegateSubject": {
      "type": "object",
      "required": [
        "expression",
        "kind",
        "qualified_name"
      ],
      "properties": {
        "expression": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "type",
            "member",
            "parameter",
            "local",
            "global",
            "return_value",
            "temporary",
            "unknown"
          ]
        },
        "qualified_name": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "delegateType": {
      "type": "object",
      "required": [
        "expression",
        "qualified_name",
        "cardinality",
        "dispatch",
        "policy",
        "evidence"
      ],
      "properties": {
        "expression": {
          "type": "string"
        },
        "qualified_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "cardinality": {
          "enum": [
            "single",
            "multicast",
            null
          ]
        },
        "dispatch": {
          "enum": [
            "native",
            "dynamic",
            null
          ]
        },
        "policy": {
          "enum": [
            null,
            "event",
            "thread_safe"
          ]
        },
        "evidence": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sourceEvidence"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "delegateCallback": {
      "type": "object",
      "required": [
        "kind",
        "expression",
        "qualified_name",
        "source_operation"
      ],
      "properties": {
        "kind": {
          "enum": [
            "member_function",
            "function",
            "reflection_name",
            "lambda",
            "delegate_value",
            "unknown"
          ]
        },
        "expression": {
          "type": "string"
        },
        "qualified_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_operation": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
