{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ue-itps:schema:ue_inspect_cxx_function",
  "title": "ue_inspect_cxx_function.py result",
  "oneOf": [
    {
      "$ref": "#/$defs/success"
    },
    {
      "allOf": [
        {
          "$ref": "urn:ue-itps:schema:common#/$defs/errorDocument"
        },
        {
          "properties": {
            "schema_version": {
              "const": "ue_inspect_cxx_function"
            }
          }
        }
      ]
    }
  ],
  "$defs": {
    "success": {
      "type": "object",
      "required": [
        "schema_version",
        "match_count",
        "matches",
        "validation",
        "limits"
      ],
      "properties": {
        "schema_version": {
          "const": "ue_inspect_cxx_function"
        },
        "match_count": {
          "type": "integer",
          "minimum": 0
        },
        "matches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/match"
          }
        },
        "validation": {
          "$ref": "urn:ue-itps:schema:common#/$defs/validation"
        },
        "limits": {
          "$ref": "urn:ue-itps:schema:common#/$defs/limits"
        }
      },
      "additionalProperties": false
    },
    "match": {
      "type": "object",
      "required": [
        "function_id",
        "external_symbols",
        "delegate_operations"
      ],
      "properties": {
        "function_id": {
          "type": "string",
          "minLength": 1
        },
        "external_symbols": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/externalSymbol"
          }
        },
        "delegate_operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/delegateOperation"
          }
        },
        "syntax_flow": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "externalSymbol": {
      "type": "object",
      "required": [
        "kind",
        "spelling",
        "evidence"
      ],
      "properties": {
        "kind": {
          "enum": [
            "type",
            "global_variable",
            "free_function",
            "macro",
            "member_call",
            "function_address",
            "callback_target",
            "unknown"
          ]
        },
        "spelling": {
          "type": "string",
          "minLength": 1
        },
        "owner_type": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/sourceEvidence"
        }
      },
      "additionalProperties": false
    },
    "delegateOperation": {
      "type": "object",
      "required": ["operation", "api", "event", "callback", "evidence"],
      "properties": {
        "operation": {
          "enum": ["publish", "subscribe"]
        },
        "api": {
          "type": "string",
          "minLength": 1
        },
        "event": {
          "$ref": "#/$defs/delegateEndpoint"
        },
        "callback": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/delegateEndpoint"}
          ]
        },
        "evidence": {
          "$ref": "#/$defs/sourceEvidence"
        }
      },
      "additionalProperties": false
    },
    "delegateEndpoint": {
      "type": "object",
      "required": ["owner_type", "name", "qualified_name"],
      "properties": {
        "owner_type": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "qualified_name": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "sourceEvidence": {
      "type": "object",
      "required": [
        "unit",
        "line"
      ],
      "properties": {
        "unit": {
          "enum": [
            "cpp",
            "header"
          ]
        },
        "line": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  }
}
