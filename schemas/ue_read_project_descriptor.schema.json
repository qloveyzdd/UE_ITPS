{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ue-itps:schema:ue_read_project_descriptor",
  "title": "ue_read_project_descriptor.py result",
  "oneOf": [
    {
      "$ref": "#/$defs/success"
    },
    {
      "allOf": [
        {
          "$ref": "urn:ue-itps:schema:common#/$defs/errorDocument"
        },
        {
          "properties": {
            "schema_version": {
              "const": "ue_read_project_descriptor"
            }
          }
        }
      ]
    }
  ],
  "$defs": {
    "success": {
      "type": "object",
      "required": [
        "schema_version",
        "declared_modules",
        "plugin_declarations",
        "validation",
        "limits"
      ],
      "properties": {
        "schema_version": {
          "const": "ue_read_project_descriptor"
        },
        "declared_modules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "plugin_declarations": {
          "type": "object",
          "required": ["enabled", "disabled", "target_allow_list"],
          "properties": {
            "enabled": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "disabled": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "target_allow_list": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "targets"],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "targets": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "validation": {
          "$ref": "urn:ue-itps:schema:common#/$defs/validation"
        },
        "limits": {
          "$ref": "urn:ue-itps:schema:common#/$defs/limits"
        }
      },
      "additionalProperties": false
    }
  }
}
