{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ue-itps:schema:ue_inspect_cxx_type",
  "title": "ue_inspect_cxx_type.py result",
  "oneOf": [
    {
      "$ref": "#/$defs/success"
    },
    {
      "allOf": [
        {
          "$ref": "urn:ue-itps:schema:common#/$defs/errorDocument"
        },
        {
          "properties": {
            "schema_version": {
              "const": "ue_inspect_cxx_type"
            }
          }
        }
      ]
    }
  ],
  "$defs": {
    "success": {
      "type": "object",
      "required": [
        "schema_version",
        "matches",
        "validation",
        "limits"
      ],
      "properties": {
        "schema_version": {
          "const": "ue_inspect_cxx_type"
        },
        "matches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/compoundTypeAnchor"
          }
        },
        "validation": {
          "$ref": "urn:ue-itps:schema:common#/$defs/validation"
        },
        "limits": {
          "$ref": "urn:ue-itps:schema:common#/$defs/limits"
        }
      },
      "additionalProperties": false
    },
    "unitEvidence": {
      "type": "object",
      "required": [
        "unit",
        "line"
      ],
      "properties": {
        "unit": {
          "enum": [
            "cpp",
            "header"
          ]
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "memberAnchor": {
      "type": "object",
      "required": [
        "kind",
        "name",
        "macros",
        "evidence"
      ],
      "properties": {
        "kind": {
          "enum": [
            "variable",
            "function"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type_expression": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        },
        "macros": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "$ref": "#/$defs/unitEvidence"
        }
      },
      "additionalProperties": false
    },
    "compoundTypeAnchor": {
      "type": "object",
      "required": [
        "name",
        "namespace",
        "qualified_name",
        "owner",
        "role",
        "base_types",
        "macros",
        "member_anchors",
        "evidence",
        "kind",
        "interface_candidate_reasons",
        "member_functions"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "qualified_name": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "const": "definition"
        },
        "base_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "macros": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "member_anchors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/memberAnchor"
          }
        },
        "evidence": {
          "$ref": "#/$defs/unitEvidence"
        },
        "kind": {
          "enum": [
            "class",
            "struct",
            "union"
          ]
        },
        "interface_candidate_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "member_functions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/memberFunctionDefinition"
          }
        }
      },
      "additionalProperties": false
    },
    "memberFunctionDefinition": {
      "type": "object",
      "required": [
        "name",
        "namespace",
        "qualified_name",
        "owner",
        "signature",
        "macros",
        "evidence"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "qualified_name": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "signature": {
          "type": "string",
          "minLength": 1
        },
        "macros": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "$ref": "#/$defs/unitEvidence"
        }
      },
      "additionalProperties": false
    }
  }
}
