{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ue-itps:schema:project-cxx-sources:v1",
  "title": "ue_list_project_cxx_sources.py result",
  "oneOf": [
    {
      "$ref": "#/$defs/success"
    },
    {
      "allOf": [
        {
          "$ref": "urn:ue-itps:schema:common:v1#/$defs/errorDocument"
        },
        {
          "properties": {
            "schema_version": {
              "const": "ue-itps.project-cxx-sources.v1"
            }
          }
        }
      ]
    }
  ],
  "$defs": {
    "pathList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "visibilityGroups": {
      "type": "object",
      "required": ["public", "private", "unclassified"],
      "properties": {
        "public": {
          "$ref": "#/$defs/pathList"
        },
        "private": {
          "$ref": "#/$defs/pathList"
        },
        "unclassified": {
          "$ref": "#/$defs/pathList"
        }
      },
      "additionalProperties": false
    },
    "module": {
      "type": "object",
      "required": [
        "module",
        "plugin",
        "plugin_descriptor",
        "build_rules",
        "headers",
        "cpp"
      ],
      "properties": {
        "module": {
          "type": "string",
          "minLength": 1
        },
        "plugin": {
          "type": ["string", "null"]
        },
        "plugin_descriptor": {
          "type": ["string", "null"]
        },
        "build_rules": {
          "type": "string",
          "minLength": 1
        },
        "headers": {
          "$ref": "#/$defs/visibilityGroups"
        },
        "cpp": {
          "$ref": "#/$defs/visibilityGroups"
        }
      },
      "additionalProperties": false
    },
    "success": {
      "type": "object",
      "required": [
        "schema_version",
        "project",
        "module_count",
        "file_count",
        "modules",
        "validation",
        "limits"
      ],
      "properties": {
        "schema_version": {
          "const": "ue-itps.project-cxx-sources.v1"
        },
        "project": {
          "type": "object",
          "required": ["name", "root", "descriptor"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "root": {
              "type": "string",
              "minLength": 1
            },
            "descriptor": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "module_count": {
          "type": "integer",
          "minimum": 0
        },
        "file_count": {
          "type": "integer",
          "minimum": 0
        },
        "modules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/module"
          }
        },
        "validation": {
          "$ref": "urn:ue-itps:schema:common:v1#/$defs/validation"
        },
        "limits": {
          "$ref": "urn:ue-itps:schema:common:v1#/$defs/limits"
        }
      },
      "additionalProperties": false
    }
  }
}
