{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ue-itps:schema:common",
  "title": "UE ITPS shared result definitions",
  "$defs": {
    "problem": {
      "type": "object",
      "required": ["severity", "code", "message"],
      "properties": {
        "severity": {
          "enum": ["info", "warning", "error"]
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "validation": {
      "type": "object",
      "required": ["status", "problem_count", "problems"],
      "properties": {
        "status": {
          "enum": ["ok", "warning", "error"]
        },
        "problem_count": {
          "type": "integer",
          "minimum": 0
        },
        "problems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/problem"
          }
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "required": ["responsibility", "boundaries"],
      "properties": {
        "responsibility": {
          "type": "string",
          "minLength": 1
        },
        "boundaries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "analysis_engines": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "requestFailure": {
      "type": "object",
      "required": ["status", "kind"],
      "properties": {
        "status": {
          "const": "failed"
        },
        "kind": {
          "enum": ["argument", "input"]
        }
      },
      "additionalProperties": false
    },
    "errorValidation": {
      "allOf": [
        {
          "$ref": "#/$defs/validation"
        },
        {
          "properties": {
            "status": {
              "const": "error"
            },
            "problem_count": {
              "type": "integer",
              "minimum": 1
            },
            "problems": {
              "type": "array",
              "minItems": 1
            }
          }
        }
      ]
    },
    "errorDocument": {
      "type": "object",
      "required": ["schema_version", "request", "validation", "limits"],
      "properties": {
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "request": {
          "$ref": "#/$defs/requestFailure"
        },
        "validation": {
          "$ref": "#/$defs/errorValidation"
        },
        "limits": {
          "$ref": "#/$defs/limits"
        }
      },
      "additionalProperties": false
    },
    "priorityView": {
      "type": "object",
      "required": [
        "mode",
        "rules_version",
        "focus"
      ],
      "properties": {
        "mode": {
          "enum": [
            "behavior",
            "structure"
          ]
        },
          "rules_version": {
            "enum": [1, 2, 3]
        },
        "focus": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "sections": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "classes": {
              "enum": [
                "expand",
                "fold"
              ]
            },
            "structs": {
              "enum": [
                "expand",
                "fold"
              ]
            },
            "enums": {
              "enum": [
                "expand",
                "fold"
              ]
            },
            "global_variables": {
              "enum": [
                "expand",
                "fold"
              ]
            },
            "free_functions": {
              "enum": [
                "expand",
                "fold"
              ]
            },
            "macros": {
              "enum": [
                "expand",
                "fold"
              ]
            }
          }
        }
      },
      "additionalProperties": false
    },
    "prioritySummary": {
      "type": "object",
      "required": [
        "source_count",
        "hidden_by_rule"
      ],
      "properties": {
        "source_count": {
          "type": "integer",
          "minimum": 0
        },
        "hidden_by_rule": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "additionalProperties": false
    },
    "retrievalStatement": {
      "type": "object",
      "required": [
        "kind",
        "expression",
        "location",
        "execution_scope"
      ],
      "properties": {
        "kind": {
          "enum": [
            "initialization",
            "assignment",
            "update",
            "condition",
            "return"
          ]
        },
        "expression": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "object",
          "required": [
            "line",
            "column"
          ],
          "properties": {
            "line": {
              "type": "integer",
              "minimum": 1
            },
            "column": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "execution_scope": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "function"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "kind",
                "line",
                "column"
              ],
              "properties": {
                "kind": {
                  "const": "lambda"
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "column": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "target": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "statementSummary": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "initialization",
          "assignment",
          "update",
          "condition",
          "return"
        ]
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "logContext": {
      "type": "object",
      "required": [
        "callee",
        "location"
      ],
      "properties": {
        "callee": {
          "enum": [
            "UE_LOG",
            "UE_CLOG"
          ]
        },
        "location": {
          "type": "object",
          "required": [
            "line",
            "column"
          ],
          "properties": {
            "line": {
              "type": "integer",
              "minimum": 1
            },
            "column": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
