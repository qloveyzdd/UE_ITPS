{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ue-itps:schema:information-pool-query",
  "title": "UE ITPS information-pool query result",
  "type": "object",
  "required": ["schema_version", "operation", "generation", "status", "result"],
  "properties": {
    "schema_version": {"const": "ue-itps.information-pool.query"},
    "operation": {
      "enum": [
        "lookup",
        "search",
        "hierarchy",
        "impact",
        "callers",
        "cycles",
        "path",
        "test-scope",
        "diff"
      ]
    },
    "generation": {
      "type": "object",
      "required": ["generation_id", "source_commit"],
      "properties": {
        "generation_id": {"type": "string", "pattern": "^generation:"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}
      },
      "additionalProperties": false
    },
    "status": {"enum": ["selected", "ambiguous", "not_found"]},
    "result": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["selected", "ambiguous", "not_found"]}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
